{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "rootDir": "../..",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "comm/request": ["./@mf-types/comm/request"],
      "comm/session": ["./@mf-types/comm/session"],
      "comm/theme": ["../../share/comm/src/theme.ts"],
      "comm/moduleContext": ["./@mf-types/comm/moduleContext"],
      "comm/navbarSlot": ["./@mf-types/comm/navbarSlot"],
      "comm/eventBus": ["../../share/comm/src/eventBus.ts"],
      "comm/resource": ["../../share/comm/src/resource.ts"],
      "comm/management": ["../../share/comm/src/management.ts"],
      "comm/utils": ["../../share/comm/src/utils.ts"]
    }
  },
  "include": ["src"]
}
