{
  "name": "comm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:federation:build": "vite build --config tests/federation/vite.config.ts",
    "test:federation": "vite preview --config tests/federation/vite.config.ts"
  },
  "dependencies": {
    "antd": "^6.6.0",
    "axios": "^1.16.1"
  },
  "devDependencies": {
    "@module-federation/vite": "1.23.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.15",
    "react": "19.2.8",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
