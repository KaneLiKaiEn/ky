{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "rootDir": "..",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "comm/request": ["../comm/src/request.ts"],
      "comm/session": ["../comm/src/session.ts"],
      "comm/theme": ["../comm/src/theme.ts"],
      "comm/resource": ["../comm/src/resource.ts"],
      "comm/management": ["../comm/src/management.ts"],
      "comm/utils": ["../comm/src/utils.ts"],
      "comm/moduleContext": ["../comm/src/moduleContext.ts"],
      "comm/eventBus": ["../comm/src/eventBus.ts"],
      "comm/navbarSlot": ["../comm/src/navbarSlot.ts"]
    }
  },
  "include": ["src"]
}
